# PRAYANA — Brutalist Architectural Noir Environment Variables

# Gemini AI Trip Copilot API Key
# Get your API key from Google AI Studio: https://aistudio.google.com
VITE_GEMINI_API_KEY=

# Google Maps Platform JavaScript API Key
# Enable Maps JavaScript API, Elevation API, and Directions API: https://console.cloud.google.com
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Configuration (Optional: pre-loaded offline demo mode is active by default)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
