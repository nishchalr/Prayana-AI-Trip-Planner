               (data.expenses.size() == 0 || (data.expenses[0] is map && data.expenses[0].keys().size() <= 15))
             )) &&
             (!('totalSpent' in data) || (data.totalSpent is number && data.totalSpent >= 0 && data.totalSpent <= 1000000000)) &&
             (!('rebalanceApplied' in data) || data.rebalanceApplied is bool) &&
             (!('uid' in data) || (isValidStringVal(data.uid, 1, 128) && data.uid == userId)) &&
             (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt)) &&
