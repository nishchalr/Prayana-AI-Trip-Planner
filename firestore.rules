             (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt));
    }

    // /users/{userId}/profiles/{profileId} individual TravelerProfile document
    function isValidTravelerProfileDoc(data, userId) {
      return hasOnlyAllowedFields([
               'id', 'name', 'username', 'dob', 'age', 'isPrimarySelf', 'ownerUid',
               'mobility', 'medicalFlags', 'dietaryTags',
               'medicalDetails', 'customDietaryKeywords',
               'vibeProfile', 'landscapePreferences', 'crowdTolerance', 'pacingPreference',
               'fitbandConnected', 'wearableStatus', 'bleDeviceName', 'isPrimary', 'vitals',
               'travelInsuranceId', 'emergencyContact', 'localGuardian',
               'uid', 'createdAt', 'updatedAt'
             ]) &&
             hasRequiredFields(['name']) &&
             (!('id' in data) || isValidStringVal(data.id, 1, 128)) &&
             isValidStringVal(data.name, 1, 120) &&
             (!('username' in data) || isValidUsernameHandle(data.username)) &&
             (!('dob' in data) || isValidDobString(data.dob)) &&
             (!('age' in data) || (data.age is number && data.age >= 0 && data.age <= 130)) &&
             (!('isPrimarySelf' in data) || data.isPrimarySelf is bool) &&
             (!('ownerUid' in data) || isValidStringVal(data.ownerUid, 1, 128)) &&
             (!('mobility' in data) || data.mobility in ['Full Mobility', 'Assisted', 'Wheelchair-Accessible']) &&
             (!('medicalFlags' in data) || isValidList(data.medicalFlags, 20)) &&
             (!('dietaryTags' in data) || isValidList(data.dietaryTags, 20)) &&
             (!('medicalDetails' in data) || (
               isValidList(data.medicalDetails, 20) &&
               (data.medicalDetails.size() == 0 || (data.medicalDetails[0] is map && data.medicalDetails[0].keys().size() <= 20))
             )) &&
             (!('customDietaryKeywords' in data) || (
               isValidList(data.customDietaryKeywords, 50) &&
               (data.customDietaryKeywords.size() == 0 || isValidStringVal(data.customDietaryKeywords[0], 0, 120))
             )) &&
             (!('vibeProfile' in data) || isValidStringVal(data.vibeProfile, 0, 500)) &&
             (!('landscapePreferences' in data) || isValidList(data.landscapePreferences, 20)) &&
             (!('crowdTolerance' in data) || data.crowdTolerance in ['Low / Solitary', 'Moderate / Standard', 'High / Festive']) &&
             (!('pacingPreference' in data) || data.pacingPreference in ['Slow & Restful', 'Balanced', 'High Exertion']) &&
             (!('fitbandConnected' in data) || data.fitbandConnected is bool) &&
             (!('wearableStatus' in data) || data.wearableStatus in ['UNPAIRED', 'BLE_CONNECTED', 'SIMULATED']) &&
             (!('bleDeviceName' in data) || data.bleDeviceName == null || isValidStringVal(data.bleDeviceName, 0, 120)) &&
             (!('isPrimary' in data) || data.isPrimary is bool) &&
             (!('vitals' in data) || isValidVitalsMap(data.vitals)) &&
             (!('travelInsuranceId' in data) || isValidStringVal(data.travelInsuranceId, 0, 128)) &&
             (!('emergencyContact' in data) || isValidEmergencyContactMap(data.emergencyContact)) &&
             (!('localGuardian' in data) || data.localGuardian == null || isValidLocalGuardianMap(data.localGuardian)) &&
             (!('uid' in data) || (isValidStringVal(data.uid, 1, 128) && data.uid == userId)) &&
             (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt));
    }

    // /users/{userId}/stops/{stopId} and .../trips/{tripId}/stops/{stopId}
    function isValidStopDoc(data, userId) {
      return hasOnlyAllowedFields([
               'id', 'index', 'title', 'subtitle',
               'elevationDeltaM', 'distanceKm', 'slopeDeg',
               'effortRating', 'vibeTag', 'optimalTime', 'dwellMinutes',
               'description', 'isOutdoor', 'cost', 'isPinned', 'coords',
               'tripId', 'uid', 'createdAt', 'updatedAt'
             ]) &&
             hasRequiredFields(['title']) &&
             (!('id' in data) || isValidStringVal(data.id, 1, 128)) &&
             isValidStringVal(data.title, 1, 200) &&
             (!('index' in data) || (data.index is number && data.index >= 0 && data.index <= 1000)) &&
             (!('subtitle' in data) || isValidStringVal(data.subtitle, 0, 300)) &&
             (!('elevationDeltaM' in data) || (data.elevationDeltaM is number && data.elevationDeltaM >= -5000 && data.elevationDeltaM <= 10000)) &&
             (!('distanceKm' in data) || (data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 50000)) &&
             (!('slopeDeg' in data) || (data.slopeDeg is number && data.slopeDeg >= -90 && data.slopeDeg <= 90)) &&
             (!('effortRating' in data) || data.effortRating in ['LOW', 'MODERATE', 'ELEVATED']) &&
             (!('vibeTag' in data) || isValidStringVal(data.vibeTag, 0, 120)) &&
             (!('optimalTime' in data) || isValidStringVal(data.optimalTime, 0, 120)) &&
             (!('dwellMinutes' in data) || (data.dwellMinutes is number && data.dwellMinutes >= 0 && data.dwellMinutes <= 1440)) &&
             (!('description' in data) || isValidStringVal(data.description, 0, 2000)) &&
             (!('isOutdoor' in data) || data.isOutdoor is bool) &&
             (!('cost' in data) || (data.cost is number && data.cost >= 0 && data.cost <= 10000000)) &&
             (!('isPinned' in data) || data.isPinned is bool) &&
             (!('coords' in data) || data.coords == null || isValidCoordsMap(data.coords)) &&
             (!('tripId' in data) || isValidStringVal(data.tripId, 1, 128)) &&
             (!('uid' in data) || (isValidStringVal(data.uid, 1, 128) && data.uid == userId)) &&
             (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt));
    }

    // /users/{userId}/expenses/{expenseId} and .../trips/{tripId}/expenses/{expenseId}
    function isValidExpenseDoc(data, userId) {
      return hasOnlyAllowedFields([
               'id', 'category', 'amount', 'description', 'dayIndex',
               'timestamp', 'tripId', 'uid', 'createdAt', 'updatedAt'
             ]) &&
             hasRequiredFields(['category', 'amount']) &&
             (!('id' in data) || isValidStringVal(data.id, 1, 128)) &&
             data.category in ['stays', 'food', 'transit', 'activitiesAndBuffer', 'activities'] &&
             data.amount is number && data.amount >= 0 && data.amount <= 100000000 &&
             (!('description' in data) || isValidStringVal(data.description, 0, 500)) &&
             (!('dayIndex' in data) || (data.dayIndex is number && data.dayIndex >= 0 && data.dayIndex <= 365)) &&
             (!('timestamp' in data) || (data.timestamp is timestamp || isValidStringVal(data.timestamp, 0, 64))) &&
             (!('tripId' in data) || isValidStringVal(data.tripId, 1, 128)) &&
             (!('uid' in data) || (isValidStringVal(data.uid, 1, 128) && data.uid == userId)) &&
             (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt));
    }

    // /users/{userId}/wishlist/{itemId} and .../trips/{tripId}/wishlist/{itemId}
    function isValidWishlistItemDoc(data, userId) {
      return hasOnlyAllowedFields([
               'id', 'poiId', 'stopId', 'destinationId', 'title',
               'poiIds', 'wishlistIds',
               'uid', 'addedAt', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().size() > 0 &&
             ('id' in data || 'poiId' in data || 'stopId' in data || 'poiIds' in data || 'wishlistIds' in data) &&
             (!('id' in data) || isValidStringVal(data.id, 1, 128)) &&
             (!('poiId' in data) || isValidStringVal(data.poiId, 1, 128)) &&
             (!('stopId' in data) || isValidStringVal(data.stopId, 1, 128)) &&
             (!('destinationId' in data) || isValidStringVal(data.destinationId, 1, 128)) &&
             (!('title' in data) || isValidStringVal(data.title, 0, 200)) &&
             (!('poiIds' in data) || (
               isValidList(data.poiIds, 500) &&
               (data.poiIds.size() == 0 || isValidStringVal(data.poiIds[0], 1, 128))
             )) &&
             (!('wishlistIds' in data) || (
               isValidList(data.wishlistIds, 500) &&
               (data.wishlistIds.size() == 0 || isValidStringVal(data.wishlistIds[0], 1, 128))
             )) &&
             (!('uid' in data) || (isValidStringVal(data.uid, 1, 128) && data.uid == userId)) &&
             (!('addedAt' in data) || isValidTimestampOrIso(data.addedAt)) &&
             (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt));
    }

    // Shared typed field checks for preference documents
    function hasValidCommonPreferenceFields(data) {
      return (!('theme' in data) || data.theme in ['dark', 'light', 'system']) &&
             (!('mapMode' in data) || data.mapMode in ['NODE_GRAPH', 'GOOGLE_MAPS']) &&
             (!('currency' in data) || isValidStringVal(data.currency, 3, 8)) &&
             (!('units' in data) || data.units in ['metric', 'imperial']) &&
             (!('language' in data) || isValidStringVal(data.language, 2, 16)) &&
             (!('pacingPreference' in data) || data.pacingPreference in ['Slow & Restful', 'Balanced', 'High Exertion']) &&
             (!('crowdTolerance' in data) || data.crowdTolerance in ['Low / Solitary', 'Moderate / Standard', 'High / Festive']) &&
             (!('mobility' in data) || data.mobility in ['Full Mobility', 'Assisted', 'Wheelchair-Accessible']) &&
             (!('landscapePreferences' in data) || (
               isValidList(data.landscapePreferences, 20) &&
               (data.landscapePreferences.size() == 0 || isValidStringVal(data.landscapePreferences[0], 1, 120))
             )) &&
             (!('dietaryTags' in data) || (
               isValidList(data.dietaryTags, 20) &&
               (data.dietaryTags.size() == 0 || isValidStringVal(data.dietaryTags[0], 1, 120))
             )) &&
             (!('medicalFlags' in data) || (
               isValidList(data.medicalFlags, 20) &&
               (data.medicalFlags.size() == 0 || isValidStringVal(data.medicalFlags[0], 1, 120))
             )) &&
             (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&
             (!('telemetryOptIn' in data) || data.telemetryOptIn is bool) &&
             (!('offlineCacheEnabled' in data) || data.offlineCacheEnabled is bool) &&
             (!('activeDestinationId' in data) || data.activeDestinationId == null || isValidStringVal(data.activeDestinationId, 1, 128)) &&
             (!('activeTravelerId' in data) || data.activeTravelerId == null || isValidStringVal(data.activeTravelerId, 1, 128));
    }

    // /users/{userId}/data/preferences document
    function isValidPreferencesDataDoc(data, userId) {
      return hasOnlyAllowedFields([
               'theme', 'mapMode', 'currency', 'units', 'language',
               'pacingPreference', 'crowdTolerance', 'mobility',
               'landscapePreferences', 'dietaryTags', 'medicalFlags',
               'notificationsEnabled', 'telemetryOptIn', 'offlineCacheEnabled',
               'activeDestinationId', 'activeTravelerId',
               'uid', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().size() > 0 &&
             ('theme' in data || 'mapMode' in data || 'currency' in data ||
              'units' in data || 'language' in data || 'pacingPreference' in data ||
              'crowdTolerance' in data || 'mobility' in data || 'landscapePreferences' in data ||
              'dietaryTags' in data || 'medicalFlags' in data || 'notificationsEnabled' in data ||
              'telemetryOptIn' in data || 'offlineCacheEnabled' in data ||
              'activeDestinationId' in data || 'activeTravelerId' in data) &&
             hasValidCommonPreferenceFields(data) &&
             (!('uid' in data) || (isValidStringVal(data.uid, 1, 128) && data.uid == userId)) &&
             (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt));
    }

    // /users/{userId}/preferences/{prefId} document
    function isValidPreferenceDoc(data, userId) {
      return hasOnlyAllowedFields([
               'id', 'key', 'category', 'label', 'value', 'enabled',
               'theme', 'mapMode', 'currency', 'units', 'language',
               'pacingPreference', 'crowdTolerance', 'mobility',
               'landscapePreferences', 'dietaryTags', 'medicalFlags',
               'notificationsEnabled', 'telemetryOptIn', 'offlineCacheEnabled',
               'activeDestinationId', 'activeTravelerId',
               'uid', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().size() > 0 &&
             ('key' in data || 'value' in data || 'enabled' in data ||
              'theme' in data || 'mapMode' in data || 'currency' in data ||
              'units' in data || 'language' in data || 'pacingPreference' in data ||
              'crowdTolerance' in data || 'mobility' in data || 'landscapePreferences' in data ||
              'dietaryTags' in data || 'medicalFlags' in data || 'notificationsEnabled' in data ||
              'telemetryOptIn' in data || 'offlineCacheEnabled' in data ||
              'activeDestinationId' in data || 'activeTravelerId' in data) &&
             (!('id' in data) || isValidStringVal(data.id, 1, 128)) &&
             (!('key' in data) || isValidStringVal(data.key, 1, 128)) &&
             (!('category' in data) || data.category in ['ui', 'travel', 'safety', 'notifications', 'accessibility', 'budget', 'general']) &&
             (!('label' in data) || isValidStringVal(data.label, 0, 120)) &&
             (!('value' in data) || (
               data.value == null ||
               data.value is bool ||
               (data.value is number && data.value >= -1000000000 && data.value <= 1000000000) ||
               isValidStringVal(data.value, 0, 500)
             )) &&
             (!('enabled' in data) || data.enabled is bool) &&
             hasValidCommonPreferenceFields(data) &&
             (!('uid' in data) || (isValidStringVal(data.uid, 1, 128) && data.uid == userId)) &&
             (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt));
    }

    // /users/{userId}/connectedFriends/{friendUid} accepted friend document
    function isValidConnectedFriendDoc(data, friendUid) {
      return hasOnlyAllowedFields([
               'uid', 'username', 'name', 'profile', 'connectedAt', 'updatedAt'
             ]) &&
             hasRequiredFields(['uid', 'username', 'name', 'profile']) &&
             isValidStringVal(data.uid, 1, 128) &&
             data.uid == friendUid &&
             isValidUsernameHandle(data.username) &&
             isValidStringVal(data.name, 1, 120) &&
             data.profile is map &&
             data.profile.keys().size() <= 35 &&
             (!('connectedAt' in data) || isValidTimestampOrIso(data.connectedAt)) &&
             (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt));
    }

    // /usernames/{username} public @username handle claim document (no PII)
    function isValidUsernameDoc(data, username) {
      return hasOnlyAllowedFields([
               'uid', 'username', 'displayName', 'createdAt', 'updatedAt'
             ]) &&
             hasRequiredFields(['uid', 'username', 'displayName']) &&
             isValidUsernameHandle(username) &&
             isValidStringVal(data.uid, 1, 128) &&
             isValidUsernameHandle(data.username) &&
             data.username == username &&
             isValidStringVal(data.displayName, 1, 120) &&
             (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt));
    }

    // /friendInvites/{inviteId} peer-to-peer friend invite document
    function isValidFriendInviteDoc(data) {
      return hasOnlyAllowedFields([
               'id', 'fromUid', 'fromUsername', 'fromName', 'fromProfile',
               'toUid', 'toUsername', 'toName', 'toProfile',
               'status', 'createdAt', 'respondedAt'
             ]) &&
             hasRequiredFields([
               'id', 'fromUid', 'fromUsername', 'fromName', 'fromProfile',
               'toUid', 'toUsername', 'status', 'createdAt'
             ]) &&
             isValidStringVal(data.id, 1, 160) &&
             isValidStringVal(data.fromUid, 1, 128) &&
             isValidUsernameHandle(data.fromUsername) &&
             isValidStringVal(data.fromName, 1, 120) &&
             data.fromProfile is map &&
             data.fromProfile.keys().size() <= 35 &&
             isValidStringVal(data.toUid, 1, 128) &&
             data.toUid != data.fromUid &&
             isValidUsernameHandle(data.toUsername) &&
             (!('toName' in data) || data.toName == null || isValidStringVal(data.toName, 1, 120)) &&
             (!('toProfile' in data) || data.toProfile == null || (data.toProfile is map && data.toProfile.keys().size() <= 35)) &&
             data.status in ['PENDING', 'ACCEPTED', 'DECLINED'] &&
             isValidTimestampOrIso(data.createdAt) &&
             (!('respondedAt' in data) || isValidTimestampOrIso(data.respondedAt));
    }

    // /friendships/{pairId} mutual friendship link document
    function isValidFriendshipDoc(data, pairId) {
      return data.keys().size() <= 16 &&
             hasRequiredFields(['uids']) &&
             data.uids is list &&
             data.uids.size() == 2 &&
             isValidStringVal(data.uids[0], 1, 128) &&
             isValidStringVal(data.uids[1], 1, 128) &&
             data.uids[0] != data.uids[1] &&
             pairId == (data.uids[0] < data.uids[1]
               ? data.uids[0] + '_' + data.uids[1]
               : data.uids[1] + '_' + data.uids[0]) &&
             (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt));
    }

    // /tripInvites/{inviteId} peer-to-peer trip invite document
    function isValidTripInviteDoc(data) {
      return data.keys().size() <= 32 &&
             hasRequiredFields(['fromUid']) &&
             isValidStringVal(data.fromUid, 1, 128) &&
             (!('toUid' in data) || isValidStringVal(data.toUid, 1, 128)) &&
             (!('status' in data) || isValidStringVal(data.status, 1, 32)) &&
             (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt) || (data.createdAt is number && data.createdAt >= 0)) &&
             (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt) || (data.updatedAt is number && data.updatedAt >= 0));
    }

    // /sharedTrips/{tripId} collaborative shared trip document
    function isValidSharedTripDoc(data) {
      return data.keys().size() <= 50 &&
             hasRequiredFields(['hostUid']) &&
             isValidStringVal(data.hostUid, 1, 128) &&
             (!('participantUids' in data) || isValidList(data.participantUids, 50)) &&
             (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt) || (data.createdAt is number && data.createdAt >= 0)) &&
             (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt) || (data.updatedAt is number && data.updatedAt >= 0));
    }

    // /communityAlerts/{alertId} corridor safety alert document
    function isValidCommunityAlertDoc(data) {
      return data.keys().size() <= 32 &&
             hasRequiredFields(['authorUid']) &&
             isValidStringVal(data.authorUid, 1, 128) &&
             (!('createdAt' in data) || isValidTimestampOrIso(data.createdAt) || (data.createdAt is number && data.createdAt >= 0)) &&
             (!('updatedAt' in data) || isValidTimestampOrIso(data.updatedAt) || (data.updatedAt is number && data.updatedAt >= 0));
    }

    // ========================================================================
    // Default Deny Rule (Root Fallback)
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================================================
    // User-Scoped Collections & Documents (/users/{userId}/...)
    // ========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       uidUnchanged() &&
                       isValidUserRootDoc(request.resource.data, userId);
      allow update: if isOwner(userId) &&
                       uidNotModified() &&
                       immutableIfPresentUnchanged('createdAt') &&
                       isValidUserRootDoc(request.resource.data, userId);
      allow delete: if isOwner(userId);

      // Workspace bundle documents: users/{userId}/data/{profiles|trip|stops|expenses|wishlist|preferences}
      match /data/profiles {
        allow read: if isOwner(userId) ||
                       (isAuthenticated() &&
                        exists(/databases/$(database)/documents/friendships/$(request.auth.uid < userId ? request.auth.uid + '_' + userId : userId + '_' + request.auth.uid)));
        allow create: if isOwner(userId) &&
                         uidUnchanged() &&
                         isValidProfilesDataDoc(request.resource.data, userId);
        allow update: if isOwner(userId) &&
                         uidNotModified() &&
                         immutableIfPresentUnchanged('createdAt') &&
                         isValidProfilesDataDoc(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /data/trip {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         uidUnchanged() &&
                         isValidTripDataDoc(request.resource.data, userId);
        allow update: if isOwner(userId) &&
                         uidNotModified() &&
                         immutableIfPresentUnchanged('createdAt') &&
                         isValidTripDataDoc(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /data/stops {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         uidUnchanged() &&
                         isValidStopsDataDoc(request.resource.data, userId);
        allow update: if isOwner(userId) &&
                         uidNotModified() &&
                         immutableIfPresentUnchanged('createdAt') &&
                         isValidStopsDataDoc(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /data/expenses {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         uidUnchanged() &&
                         isValidExpensesDataDoc(request.resource.data, userId);
        allow update: if isOwner(userId) &&
                         uidNotModified() &&
                         immutableIfPresentUnchanged('createdAt') &&
                         isValidExpensesDataDoc(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /data/wishlist {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         uidUnchanged() &&
                         isValidWishlistDataDoc(request.resource.data, userId);
        allow update: if isOwner(userId) &&
                         uidNotModified() &&
                         immutableIfPresentUnchanged('createdAt') &&
                         isValidWishlistDataDoc(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /data/preferences {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         uidUnchanged() &&
                         isValidPreferencesDataDoc(request.resource.data, userId);
        allow update: if isOwner(userId) &&
                         uidNotModified() &&
                         immutableIfPresentUnchanged('createdAt') &&
                         isValidPreferencesDataDoc(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      // User subcollections: profiles, trips (+ nested stops/expenses/wishlist), preferences, stops, expenses, wishlist
      match /profiles/{profileId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         uidUnchanged() &&
                         isValidTravelerProfileDoc(request.resource.data, userId);
        allow update: if isOwner(userId) &&
                         uidNotModified() &&
                         immutableIfPresentUnchanged('createdAt') &&
                         isValidTravelerProfileDoc(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /trips/{tripId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         uidUnchanged() &&
                         isValidTripDataDoc(request.resource.data, userId);
        allow update: if isOwner(userId) &&
                         uidNotModified() &&
                         immutableIfPresentUnchanged('createdAt') &&
                         isValidTripDataDoc(request.resource.data, userId);
        allow delete: if isOwner(userId);

        match /stops/{stopId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) &&
                           uidUnchanged() &&
                           isValidStopDoc(request.resource.data, userId);
          allow update: if isOwner(userId) &&
                           uidNotModified() &&
                           immutableIfPresentUnchanged('createdAt') &&
                           isValidStopDoc(request.resource.data, userId);
          allow delete: if isOwner(userId);
        }

        match /expenses/{expenseId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) &&
                           uidUnchanged() &&
                           isValidExpenseDoc(request.resource.data, userId);
          allow update: if isOwner(userId) &&
                           uidNotModified() &&
                           immutableIfPresentUnchanged('createdAt') &&
                           isValidExpenseDoc(request.resource.data, userId);
          allow delete: if isOwner(userId);
        }

        match /wishlist/{itemId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) &&
                           uidUnchanged() &&
                           isValidWishlistItemDoc(request.resource.data, userId);
          allow update: if isOwner(userId) &&
                           uidNotModified() &&
                           immutableIfPresentUnchanged('createdAt') &&
                           isValidWishlistItemDoc(request.resource.data, userId);
          allow delete: if isOwner(userId);
        }
      }

      match /stops/{stopId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         uidUnchanged() &&
                         isValidStopDoc(request.resource.data, userId);
        allow update: if isOwner(userId) &&
                         uidNotModified() &&
                         immutableIfPresentUnchanged('createdAt') &&
                         isValidStopDoc(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         uidUnchanged() &&
                         isValidExpenseDoc(request.resource.data, userId);
        allow update: if isOwner(userId) &&
                         uidNotModified() &&
                         immutableIfPresentUnchanged('createdAt') &&
                         isValidExpenseDoc(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /wishlist/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         uidUnchanged() &&
                         isValidWishlistItemDoc(request.resource.data, userId);
        allow update: if isOwner(userId) &&
                         uidNotModified() &&
                         immutableIfPresentUnchanged('createdAt') &&
                         isValidWishlistItemDoc(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /preferences/{prefId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         uidUnchanged() &&
                         isValidPreferenceDoc(request.resource.data, userId);
        allow update: if isOwner(userId) &&
                         uidNotModified() &&
                         immutableIfPresentUnchanged('createdAt') &&
                         isValidPreferenceDoc(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /connectedFriends/{friendUid} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidConnectedFriendDoc(request.resource.data, friendUid);
        allow update: if isOwner(userId) &&
                         isValidConnectedFriendDoc(request.resource.data, friendUid);
        allow delete: if isOwner(userId);
      }
    }

    // ========================================================================
    // Unique @username Claims (/usernames/{username})
    // ========================================================================
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid &&
                       isValidUsernameDoc(request.resource.data, username);
      allow update: if isDocOwner() &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.username == resource.data.username &&
                       immutableIfPresentUnchanged('createdAt') &&
                       isValidUsernameDoc(request.resource.data, username);
      allow delete: if isDocOwner();
    }

    // ========================================================================
    // Peer-to-Peer Friend Invites (/friendInvites/{inviteId})
    // ========================================================================
    match /friendInvites/{inviteId} {
      allow read: if isAuthenticated() &&
                     (resource.data.fromUid == request.auth.uid ||
                      resource.data.toUid == request.auth.uid);
      allow create: if isAuthenticated() &&
                       request.resource.data.fromUid == request.auth.uid &&
                       request.resource.data.toUid != request.auth.uid &&
                       request.resource.data.status == 'PENDING' &&
                       isValidFriendInviteDoc(request.resource.data);
      allow update: if isAuthenticated() &&
                       resource.data.toUid == request.auth.uid &&
                       resource.data.status == 'PENDING' &&
                       areImmutableFieldsUnchanged([
                         'id', 'fromUid', 'fromUsername', 'fromName', 'fromProfile',
                         'toUid', 'toUsername', 'createdAt'
                       ]) &&
                       request.resource.data.status in ['ACCEPTED', 'DECLINED'] &&
                       isValidFriendInviteDoc(request.resource.data);
      allow delete: if isAuthenticated() &&
                       (resource.data.fromUid == request.auth.uid ||
                        resource.data.toUid == request.auth.uid);
    }

    // ========================================================================
    // Mutual Friendships (/friendships/{pairId})
    // ========================================================================
    match /friendships/{pairId} {
      allow read, delete: if isAuthenticated() &&
                             ((resource.data.uids is list &&
                               request.auth.uid in resource.data.uids) ||
                              request.auth.uid == resource.data.uidA ||
                              request.auth.uid == resource.data.uidB);
      allow create: if isAuthenticated() &&
                       isValidFriendshipDoc(request.resource.data, pairId) &&
                       request.auth.uid in request.resource.data.uids;
      allow update: if isAuthenticated() &&
                       resource.data.uids is list &&
                       request.auth.uid in resource.data.uids &&
                       request.resource.data.uids == resource.data.uids &&
                       immutableIfPresentUnchanged('createdAt') &&
                       isValidFriendshipDoc(request.resource.data, pairId);
    }

    // ========================================================================
    // Peer-to-Peer Trip Invites (/tripInvites/{inviteId})
    // ========================================================================
    match /tripInvites/{inviteId} {
      allow read: if isAuthenticated() &&
                     (resource.data.fromUid == request.auth.uid ||
                      resource.data.toUid == request.auth.uid);
      allow create: if isAuthenticated() &&
                       request.resource.data.fromUid == request.auth.uid &&
                       isValidTripInviteDoc(request.resource.data);
      allow update: if isAuthenticated() &&
                       (resource.data.fromUid == request.auth.uid ||
                        resource.data.toUid == request.auth.uid) &&
                       request.resource.data.fromUid == resource.data.fromUid &&
                       immutableIfPresentUnchanged('createdAt') &&
                       isValidTripInviteDoc(request.resource.data);
      allow delete: if isAuthenticated() &&
                       (resource.data.fromUid == request.auth.uid ||
                        resource.data.toUid == request.auth.uid);
    }

    // ========================================================================
    // Collaborative Shared Trips (/sharedTrips/{tripId})
    // ========================================================================
    match /sharedTrips/{tripId} {
      allow read: if isAuthenticated() &&
                     (resource.data.hostUid == request.auth.uid ||
                      (resource.data.participantUids is list &&
                       request.auth.uid in resource.data.participantUids));
      allow create: if isAuthenticated() &&
                       request.resource.data.hostUid == request.auth.uid &&
                       isValidSharedTripDoc(request.resource.data);
      allow update: if isAuthenticated() &&
                       (resource.data.hostUid == request.auth.uid ||
                        (resource.data.participantUids is list &&
                         request.auth.uid in resource.data.participantUids)) &&
                       request.resource.data.hostUid == resource.data.hostUid &&
                       immutableIfPresentUnchanged('createdAt') &&
                       isValidSharedTripDoc(request.resource.data);
      allow delete: if isAuthenticated() &&
                       resource.data.hostUid == request.auth.uid;
    }

    // ========================================================================
    // Community Corridor Safety Alerts (/communityAlerts/{alertId})
    // ========================================================================
    match /communityAlerts/{alertId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.authorUid == request.auth.uid &&
                       isValidCommunityAlertDoc(request.resource.data);
      allow update: if false;
      allow delete: if isAuthenticated() &&
                       resource.data.authorUid == request.auth.uid;
    }
  }
}
